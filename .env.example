# Application Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.

APP_NAME="Visitor Photo Slideshow"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/visitor-photo-slideshow

# Database Connection (MySQL / MariaDB in XAMPP)
# Note: Default XAMPP port is 3306. If port 3306 is occupied, use 3307.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=visitor_slideshow_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Slideshow Default Settings
SLIDESHOW_INTERVAL=8
SLIDESHOW_AUTO_REFRESH=30

# File Upload Constraints
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
