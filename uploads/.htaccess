# Security: Prevent execution of any scripts in the uploads directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|sh|bash|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable PHP engine if mod_php is loaded
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Force default handler for images
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7
</IfModule>
